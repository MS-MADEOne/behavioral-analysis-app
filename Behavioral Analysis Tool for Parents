    let assessmentData = {
      ageGroup: "",
      childName: "",
      assessmentDate: new Date().toISOString().split("T")[0],
      scores: {},
    };
    let indexToCategory = {};

    function showSection(id) {
      document.querySelectorAll(".section").forEach((s) => s.classList.remove("active"));
      document.getElementById(id).classList.add("active");
    }

    function moveToStep1() {
      assessmentData = {
        ageGroup: "",
        childName: "",
        assessmentDate: new Date().toISOString().split("T")[0],
        scores: {},
      };
      indexToCategory = {};
      document.getElementById("ageGroup").value = "";
      document.getElementById("childName").value = "";
      document.getElementById("assessmentDate").valueAsDate = new Date();
      showSection("step1");
    }

    function moveToStep2() {
      const ageGroup = document.getElementById("ageGroup").value;
      if (!ageGroup) {
        alert("Please select an age group.");
        return;
      }
      assessmentData.ageGroup = ageGroup;
      document.getElementById("assessmentDate").valueAsDate = new Date();
      showSection("step2");
    }

    function moveToStep3() {
      assessmentData.childName =
        document.getElementById("childName").value.trim() || "Child";
      assessmentData.assessmentDate =
        document.getElementById("assessmentDate").value ||
        new Date().toISOString().split("T")[0];

      const data = behaviorData[assessmentData.ageGroup];
      if (!data) {
        alert("Questions for this age group are not configured.");
        return;
      }

      let html = "";
      let globalIndex = 0;
      indexToCategory = {};

      for (const [catName, patterns] of Object.entries(data.categories)) {
        html += `<div class="category-header">${catName}</div>`;
        patterns.forEach((item) => {
          indexToCategory[globalIndex] = catName;
          html += `
            <div class="pattern-item">
              <label class="pattern-label">${globalIndex + 1}. ${item.pattern}</label>
              <div class="example-text">📝 Example: ${item.example}</div>
              <div class="scale-container">
                ${[0,1,2,3,4,5].map((scale) => `
                  <div>
                    <button
                      class="scale-btn"
                      onclick="setScore(${globalIndex}, ${scale})"
                      id="scale-${globalIndex}-${scale}"
                    >${scale}</button>
                    <div class="scale-label">${["Never","Rarely","Sometimes","Often","V. Often","Always"][scale]}</div>
                  </div>
                `).join("")}
              </div>
              <div class="scale-legend">
                <span>0 = Never observed</span>
                <span>5 = Always observed</span>
              </div>
            </div>
          `;
          globalIndex++;
        });
      }

      document.getElementById("patternsContainer").innerHTML = html;
      const total = globalIndex;
      document.getElementById("ageGroupTitle").textContent =
        `${data.name} • ${total} patterns`;
      document.getElementById("overallProgress").style.width = "0%";
      document.getElementById("progressText").textContent =
        `0 of ${total} patterns completed`;
      document.getElementById("reportBtn").disabled = true;
      showSection("step3");
    }

    function setScore(index, score) {
      assessmentData.scores[index] = score;

      for (let s = 0; s <= 5; s++) {
        const btn = document.getElementById(`scale-${index}-${s}`);
        if (btn) btn.classList.remove("selected");
      }
      const selected = document.getElementById(`scale-${index}-${score}`);
      if (selected) selected.classList.add("selected");

      const total = Object.keys(indexToCategory).length;
      const completed = Object.keys(assessmentData.scores).length;
      const pct = ((completed / total) * 100).toFixed(0);
      document.getElementById("overallProgress").style.width = pct + "%";
      document.getElementById("progressText").textContent =
        `${completed} of ${total} patterns completed`;

      if (completed === total) {
        const btn = document.getElementById("reportBtn");
        btn.disabled = false;
        btn.textContent = "✅ Generate full report →";
      }
    }

    function generateReport() {
      const scores = assessmentData.scores;
      const indices = Object.keys(scores).map((k) => parseInt(k, 10));
      if (!indices.length) {
        alert("Please rate at least one pattern.");
        return;
      }

      let totalScore = 0;
      indices.forEach((i) => (totalScore += scores[i]));
      const avg = (totalScore / indices.length).toFixed(1);
      const pct = ((avg / 5) * 100).toFixed(1);

      const catAgg = {};
      for (const [idxStr, cat] of Object.entries(indexToCategory)) {
        const idx = parseInt(idxStr, 10);
        if (!(cat in catAgg)) catAgg[cat] = { sum: 0, count: 0 };
        if (scores[idx] !== undefined) {
          catAgg[cat].sum += scores[idx];
          catAgg[cat].count += 1;
        }
      }

      const strengths = [];
      const monitor = [];
      const improve = [];

      const suggestionText = {
        "🧡 Emotional Regulation": [
          "Name feelings out loud for your child (e.g., 'You look upset because playtime ended').",
          "Practise short calm‑down routines (deep breaths, counting to 10, hug/cuddle time).",
          "Keep routines predictable so big emotions are easier to handle."
        ],
        "💙 Social Skills": [
          "Arrange short, supervised playtimes or group activities with peers.",
          "Role‑play sharing, taking turns, and saying sorry at home.",
          "Praise specific positive social behaviours (e.g., 'I liked how you waited for your turn')."
        ],
        "🧠 Cognitive Development": [
          "Use age‑appropriate puzzles, board games, and problem‑solving activities.",
          "Ask open questions like 'How could we fix this?' instead of giving solutions immediately.",
          "Create a quiet, distraction‑free time for homework or focused play."
        ],
        "🗣️ Self-Expression (Communication)": [
          "Encourage your child to talk about their day with 'What was the best/worst part?' questions.",
          "Model clear, respectful communication in the family.",
          "Provide safe chances to share opinions, even if you disagree."
        ],
        "📋 Behavioral Patterns": [
          "Use simple visual routines (charts for morning, homework, bedtime).",
          "Be consistent with rules about sleep, homework, and screens.",
          "Break big tasks into small steps and praise completion."
        ],
        "💛 Emotional Intelligence": [
          "Talk about characters’ feelings in stories, movies, or daily life.",
          "Ask 'How do you think they felt?' to build perspective‑taking.",
          "Share your own feelings in a calm way to model healthy expression."
        ],
        "👨‍👩‍👧 Attachment": [
          "Spend regular one‑to‑one time (even 10–15 minutes) with full attention.",
          "Listen without judging when your child talks about worries or mistakes.",
          "Offer comfort and predictability so your child feels safe to come to you."
        ]
      };

      const orderedCategories = Object.keys(
        behaviorData[assessmentData.ageGroup].categories
      );

      const perCategoryResults = orderedCategories.map((catName) => {
        const agg = catAgg[catName] || { sum: 0, count: 0 };
        const cAvg = agg.count ? (agg.sum / agg.count).toFixed(1) : "0.0";
        const cNum = parseFloat(cAvg);
        let tag = "";
        if (cNum >= 4.0) {
          tag = "Strength";
          strengths.push(catName);
        } else if (cNum >= 3.0) {
          tag = "Doing okay / Monitor";
          monitor.push(catName);
        } else {
          tag = "Needs improvement";
          improve.push(catName);
        }
        const cPct = agg.count ? Math.round((cNum / 5) * 100) : 0;
        return { catName, cAvg, cNum, cPct, tag };
      });

      let overallSummary = "";
      if (avg >= 4.0) {
        overallSummary =
          "Overall pattern is strong. Continue current parenting approach, while fine‑tuning a few areas.";
      } else if (avg >= 3.0) {
        overallSummary =
          "Overall development is generally on track, with some clear areas where extra support will help.";
      } else {
        overallSummary =
          "Overall pattern suggests your child would benefit from consistent support and possibly professional guidance.";
      }

      let reportHTML = `
        <div class="report-section">
          <div class="report-title">📋 Behavioural Assessment Report</div>
          <p><strong>Child:</strong> ${assessmentData.childName}</p>
          <p><strong>Age group:</strong> ${behaviorData[assessmentData.ageGroup].name}</p>
          <p><strong>Date:</strong> ${new Date(assessmentData.assessmentDate).toLocaleDateString()}</p>
          <p style="margin-top:8px;">
            <strong>Overall score:</strong> ${avg}/5.0 (${pct}%)
          </p>
          <p style="margin-top:8px;">${overallSummary}</p>
        </div>
      `;

      reportHTML += `
        <div class="report-section">
          <div class="report-title">📊 Category scores (7 parameters)</div>
      `;

      perCategoryResults.forEach(({ catName, cAvg, cPct, tag }) => {
        const color =
          tag === "Strength"
            ? "#27ae60"
            : tag === "Doing okay / Monitor"
            ? "#f39c12"
            : "#e74c3c";
        reportHTML += `
          <div class="category-row">
            <span class="category-name" style="color:${color};">
              ${catName} &nbsp; <span style="font-size:12px;">(${tag})</span>
            </span>
            <div class="score-bar-small">
              <div class="score-fill-small" style="width:${cPct}%;"></div>
            </div>
            <span class="score-value" style="color:${color};">${cAvg}/5</span>
          </div>
        `;
      });

      reportHTML += `</div>`;

      reportHTML += `
        <div class="report-section">
          <div class="report-title">🎯 Priority focus areas for parents</div>
      `;

      if (improve.length === 0) {
        reportHTML += `
          <p>There are no parameters in the “Needs improvement” range. You can continue to support your child by maintaining current routines and monitoring changes over time.</p>
        `;
      } else {
        reportHTML += `
          <p>The following parameters scored below 3.0/5 and are good starting points for focused support:</p>
        `;
        improve.forEach((catName) => {
          const actions = suggestionText[catName] || [];
          reportHTML += `
            <div style="margin-top:12px; padding:10px; background:#fff; border-radius:8px;">
              <strong>${catName}</strong>
              <ul style="margin-left:18px; font-size:14px; line-height:1.6; margin-top:6px;">
                ${
                  actions.length
                    ? actions.map((a) => `<li>${a}</li>`).join("")
                    : "<li>Spend a few minutes each day noticing and praising small positive behaviours in this area.</li>"
                }
              </ul>
            </div>
          `;
        });
      }

      reportHTML += `</div>`;

      reportHTML += `
        <div class="report-section">
          <div class="report-title">💚 Strengths to maintain</div>
      `;

      if (strengths.length === 0) {
        reportHTML += `<p>No parameter is strongly above 4.0/5 yet. That is okay – focus on building consistency and small daily improvements.</p>`;
      } else {
        reportHTML += `
          <p>These parameters are current strengths (≥ 4.0/5). Keep reinforcing them through praise and opportunities to practise:</p>
          <ul style="margin-left:18px; font-size:14px; line-height:1.6;">
            ${strengths.map((c) => `<li>${c}</li>`).join("")}
          </ul>
        `;
      }

      if (monitor.length > 0) {
        reportHTML += `
          <p style="margin-top:10px;">
            The following parameters are in a healthy but “monitor” range (3.0–3.9/5):<br>
            <em>${monitor.join(", ")}</em><br>
            Keep an eye on these; they can become strengths with regular support.
          </p>
        `;
      }

      reportHTML += `</div>`;

      document.getElementById("reportContainer").innerHTML = reportHTML;
      showSection("step4");
    }

    document.addEventListener("DOMContentLoaded", () => {
      const d = document.getElementById("assessmentDate");
      if (d) d.valueAsDate = new Date();
    });
  </script>
</body>
</html>

