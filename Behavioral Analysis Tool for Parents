            { pattern: "Can say when scared", example: "Says 'I'm scared of dark/animal'." },
          ],
          "👨‍👩‍👧 Attachment": [
            { pattern: "Seeks comfort from caregiver", example: "Comes to you when hurt or scared." },
            { pattern: "Separates with brief upset", example: "Cries briefly at preschool then settles." },
            { pattern: "Checks back while playing", example: "Looks at you or returns to you during play." },
          ],
        },
      },
      "6-10": {
        name: "6–10 years • Primary School",
        categories: {
          "🧡 Emotional Regulation": [
            { pattern: "Handles losing in games", example: "Accepts defeat without long sulking or outburst." },
            { pattern: "Controls anger with words", example: "Says 'I'm upset' instead of hitting or throwing." },
            { pattern: "Recovers from criticism", example: "Improves work after teacher/parent feedback." },
