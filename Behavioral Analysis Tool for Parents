          "💛 Emotional Intelligence": [
            { pattern: "Notices when others are sad", example: "Looks concerned when sibling/parent is crying." },
            { pattern: "Shows basic empathy", example: "Offers hug or toy to upset person." },
            { pattern: "Enjoys praise", example: "Smiles and repeats action when praised." },
