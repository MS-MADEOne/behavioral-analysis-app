            { pattern: "Discusses disagreements respectfully", example: "Can debate without insult." },
            { pattern: "Shares personal views", example: "Talks about interests, beliefs, goals." },
            { pattern: "Uses digital communication fairly", example: "Texts/posts mostly respectful." },
            { pattern: "Can ask for privacy", example: "Says 'I need some space' without aggression." },
          ],
          "📋 Behavioral Patterns": [
            { pattern: "Follows school and home rules", example: "Rarely in trouble for repeated rule-breaking." },
            { pattern: "Completes assignments mostly on time", example: "Only occasional last-minute rush." },
            { pattern: "Takes basic care of health", example: "Bathing, brushing, basic hygiene." },
            { pattern: "Balances screens and offline life", example: "Has time for studies, hobbies, family." },
            { pattern: "Shows responsibility", example: "Remembers important dates, homework, deadlines." },
          ],
          "💛 Emotional Intelligence": [
            { pattern: "Understands others' perspectives", example: "Can explain why friend/parent might feel upset." },
            { pattern: "Shows empathy in actions", example: "Supports a struggling classmate." },
            { pattern: "Manages jealousy/comparison", example: "Does not constantly put self or others down." },
            { pattern: "Accepts feedback", example: "Listens to teachers/parents without always arguing." },
            { pattern: "Thinks about right vs wrong", example: "Asks if something is ethical or fair." },
          ],
          "👨‍👩‍👧 Attachment": [
            { pattern: "Keeps some communication with parents", example: "Shares at least important events." },
            { pattern: "Seeks guidance in big decisions", example: "Talks before choosing subjects/activities." },
            { pattern: "Maintains trust", example: "Generally honest about where/with whom they are." },
