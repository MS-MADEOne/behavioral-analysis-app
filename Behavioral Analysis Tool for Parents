            { pattern: "Expresses opinions respectfully", example: "Says 'I think…' without shouting." },
            { pattern: "Asks for help when needed", example: "Approaches teacher/parent before getting stuck." },
            { pattern: "Understands simple humour", example: "Laughs appropriately at basic jokes." },
            { pattern: "Participates in discussions", example: "Answers questions or shares ideas." },
          ],
          "📋 Behavioral Patterns": [
            { pattern: "Follows daily school routine", example: "Gets ready with minimal reminders." },
            { pattern: "Completes homework on time", example: "Usually finishes before deadline." },
            { pattern: "Takes care of belongings", example: "Rarely loses stationery or books." },
            { pattern: "Follows screen-time rules", example: "Stops when time is over." },
            { pattern: "Helps with simple chores", example: "Sets table, cleans room with guidance." },
          ],
          "💛 Emotional Intelligence": [
            { pattern: "Recognises others' feelings", example: "Notices when friend is lonely or upset." },
            { pattern: "Shows empathy in words", example: "Says 'Are you OK?' or offers to help." },
            { pattern: "Admits mistakes", example: "Can apologise without extreme shame." },
            { pattern: "Handles praise/modesty", example: "Feels proud but not arrogant." },
            { pattern: "Understands fairness", example: "Comments when something is unfair to others." },
          ],
          "👨‍👩‍👧 Attachment": [
            { pattern: "Talks openly with parents", example: "Shares school or friend issues at home." },
            { pattern: "Accepts guidance", example: "Listens to advice even if not fully happy." },
            { pattern: "Seeks support when worried", example: "Comes to caregiver during strong worries." },
          ],
        },
      },
      "11-15": {
        name: "11–15 years • Early Teen",
        categories: {
          "🧡 Emotional Regulation": [
            { pattern: "Manages mood swings", example: "Irritation passes without shouting at everyone." },
            { pattern: "Controls impulses", example: "Thinks before reacting on social media or in class." },
            { pattern: "Handles academic pressure", example: "Feels stressed but continues studying." },
            { pattern: "Accepts boundaries", example: "Respects rules about outings, phone, night-time." },
            { pattern: "Reflects after conflicts", example: "Later understands own role in argument." },
          ],
          "💙 Social Skills": [
            { pattern: "Maintains close friendships", example: "Has 1–3 close friends with regular contact." },
            { pattern: "Respects differences", example: "Does not mock others for looks/background." },
            { pattern: "Handles peer pressure", example: "Can say no to unsafe/unfair requests." },
            { pattern: "Communicates in groups", example: "Speaks and listens in group discussions." },
            { pattern: "Resolves conflicts more maturely", example: "Uses talk, messages, or mediator instead of fight." },
          ],
          "🧠 Cognitive Development": [
            { pattern: "Thinks about consequences", example: "Considers results before decisions." },
            { pattern: "Sets simple goals", example: "Plans study for tests over few days." },
            { pattern: "Handles increasing workload", example: "Balances school, hobbies, homework." },
            { pattern: "Shows abstract thinking", example: "Understands ideas like justice, future, values." },
